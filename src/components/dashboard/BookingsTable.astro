  border: none;
  border-radius: 999px;
  padding: 0.4rem 1.25rem;
  background: rgba(6, 6, 32, 0.06);
  color: #060620;
  font-weight: 600;
  cursor: pointer;
}

.bookings__table-wrapper {
  overflow-x: auto;
}

.bookings__table {
  width: 100%;
  border-collapse: collapse;
  font-size: 0.95rem;
}

.bookings__table thead {
  background: #f9fafc;
  color: #94a3b8;
  text-transform: uppercase;
  letter-spacing: 0.03em;
}

.bookings__table th,
.bookings__table td {
  padding: 0.9rem 1rem;
}

.bookings__table tbody tr + tr {
  border-top: 1px solid rgba(6, 6, 32, 0.07);
}

.customer {
  font-weight: 600;
  color: #060620;
}

.muted {
  color: #94a3b8;
}

.align-right {
  text-align: right;
}

.amount {
  font-weight: 600;
  color: #060620;
}

.status-badge {
  display: inline-flex;
