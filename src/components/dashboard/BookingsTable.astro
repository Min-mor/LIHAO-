---
interface BookingRow {
  customer: string;
  status: 'paid' | 'pending' | 'refunded';
  date: string;
  amount: string;
}

interface Props {
  rows: BookingRow[];
}

const { rows } = Astro.props as Props;

const statusLabel: Record<BookingRow['status'], string> = {
  paid: 'Paid',
  pending: 'Pending',
  refunded: 'Refunded'
};

const badgeClass: Record<BookingRow['status'], string> = {
  paid: 'status-badge status-badge--emerald',
  pending: 'status-badge status-badge--amber',
  refunded: 'status-badge status-badge--slate'
};
---

<section class="bookings">
  <header class="bookings__header">
    <div>
      <p class="bookings__eyebrow">Recent Activity</p>
      <h2 class="bookings__title">Recent Bookings</h2>
    </div>
    <button class="bookings__filter">Last 30 Days</button>
  </header>

  <div class="bookings__table-wrapper">
    <table class="bookings__table">
      <thead>
        <tr>
          <th>Customer</th>
          <th>Status</th>
          <th>Date</th>
          <th class="align-right">Amount</th>
        </tr>
      </thead>
      <tbody>
        {rows.map((row) => (
          <tr>
            <td class="customer">{row.customer}</td>
            <td>
              <span class={badgeClass[row.status]}>{statusLabel[row.status]}</span>
            </td>
            <td class="muted">{row.date}</td>
            <td class="align-right amount">{row.amount}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
</section>

<style scoped>
.bookings {
  border-radius: 1.5rem;
  background: #ffffff;
  border: 1px solid rgba(6, 6, 32, 0.06);
  padding: 1.75rem;
  box-shadow: 0 25px 55px rgba(6, 6, 32, 0.06);
  display: flex;
  flex-direction: column;
  gap: 1.5rem;
}

