---
interface Props {
  title: string;
  value: string;
  trend: string;
  trendLabel: string;
  accent?: 'emerald' | 'amber' | 'slate';
}

const baseProps = Astro.props as Props;
const accent = baseProps.accent ?? 'emerald';
const { title, value, trend, trendLabel } = baseProps;

const badgeClassMap: Record<NonNullable<Props['accent']>, string> = {
  emerald: 'trend-badge trend-badge--emerald',
  amber: 'trend-badge trend-badge--amber',
  slate: 'trend-badge trend-badge--slate'
};
---

<article class="stat-card">
  <div class="stat-card__text">
    <p class="stat-card__title">{title}</p>
    <p class="stat-card__value">{value}</p>
  </div>
  <div class="stat-card__trend">
    <span class={badgeClassMap[accent]}>{trend}</span>
    <span class="stat-card__trend-label">{trendLabel}</span>
  </div>
</article>

<style scoped>
.stat-card {
  border-radius: 1.5rem;
  background: #ffffff;
  border: 1px solid rgba(6, 6, 32, 0.05);
  padding: 1.5rem;
  display: flex;
  flex-direction: column;
  gap: 0.75rem;
  box-shadow: 0 20px 45px rgba(6, 6, 32, 0.05);
}

.stat-card__title {
  font-size: 0.95rem;
  color: #6b7280;
  margin: 0 0 0.35rem 0;
}

.stat-card__value {
  font-size: 2rem;
  font-weight: 700;
  color: #060620;
  margin: 0;
}

.stat-card__trend {
  display: flex;
  align-items: center;
  gap: 0.5rem;
}

.trend-badge {
  font-size: 0.75rem;
  font-weight: 600;
  padding: 0.2rem 0.75rem;
  border-radius: 999px;
}

.trend-badge--emerald {
  color: #0f9b63;
  background: rgba(32, 185, 112, 0.15);
}

.trend-badge--amber {
  color: #c57119;
  background: rgba(255, 146, 62, 0.2);
}

.trend-badge--slate {
  color: #475569;
  background: rgba(148, 163, 184, 0.25);
}

.stat-card__trend-label {
  font-size: 0.8rem;
  color: #94a3b8;
}

@media (max-width: 768px) {
  .stat-card {
    border-radius: 1rem;
    padding: 1.25rem;
  }

  .stat-card__value {
    font-size: 1.6rem;
  }
}
</style>
