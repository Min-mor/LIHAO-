---
import '@/styles/global.css';
import AdminLayout from '@/components/vue/layouts/AdminLayout.vue';
import StatsCard from '@/components/dashboard/StatsCard.astro';
import BookingsTable from '@/components/dashboard/BookingsTable.astro';
import ProfilePanel from '@/components/dashboard/ProfilePanel.vue';
---

<AdminLayout client:only="vue">
  <div class="stats-grid">
    <StatsCard title="Total Revenue" value="$45,231.89" trend="+20.1%" trendLabel="vs last month" accent="emerald" />
    <StatsCard title="Subscriptions" value="+2,350" trend="+180.1%" trendLabel="vs last month" accent="amber" />
    <StatsCard title="Sales" value="+12,234" trend="+19%" trendLabel="vs last month" accent="slate" />
  </div>

  <BookingsTable
    rows={[
      { customer: 'Liam Johnson', status: 'paid', date: 'Nov 14, 2023', amount: '$250.00' },
      { customer: 'Olivia Smith', status: 'pending', date: 'Nov 14, 2023', amount: '$150.00' },
      { customer: 'Noah Williams', status: 'refunded', date: 'Nov 13, 2023', amount: '$350.00' }
    ]}
  />

  <Fragment slot="profile">
    <ProfilePanel
      client:only="vue"
      name="Raffialdo Bayu"
      role="Platform Administrator"
      statusLabel="Active"
      activities={[
        { title: "Merchant 'Grand Hyatt' approved.", time: '15 minutes ago', status: 'success' },
        { title: 'New booking #84393 for Bali tour.', time: '1 hour ago', status: 'warning' },
        { title: 'Payment gateway API reported an issue.', time: '3 hours ago', status: 'error' }
      ]}
    />
  </Fragment>
</AdminLayout>

<style scoped>
.stats-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
  gap: 1.25rem;
  margin-bottom: 1.5rem;
}
</style>
