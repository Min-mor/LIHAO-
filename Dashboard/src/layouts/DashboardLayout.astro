---
import '@/styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const { title = 'Aurora Dashboard', description = 'Unified Astro playground for React & Vue teams' } = Astro.props as Props;
---

<html lang="zh-CN" class="bg-slate-950 text-slate-50">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body class="min-h-screen bg-slate-950">
    <div class="flex min-h-screen">
      <aside class="hidden w-64 flex-col border-r border-white/5 bg-slate-900/40 p-6 md:flex">
        <div class="mb-8 text-xl font-semibold tracking-wide">Aurora</div>
        <nav class="flex flex-1 flex-col gap-2 text-sm text-slate-300">
          <a class="rounded-md px-3 py-2 font-medium text-white/90 transition hover:bg-white/10" href="/">概览</a>
          <span class="rounded-md px-3 py-2 text-white/70">组件库 (shadcn)</span>
          <span class="rounded-md px-3 py-2 text-white/70">组件库 (shadcn-vue)</span>
        </nav>
        <p class="text-xs text-slate-400">Astro · React · Vue</p>
      </aside>

      <main class="flex-1 bg-slate-950/80 p-4 md:p-8">
        <header class="mb-8 flex flex-col gap-4 md:flex-row md:items-center md:justify-between">
          <div>
            <p class="text-xs uppercase tracking-[0.3em] text-emerald-400/80">dashboard</p>
            <h1 class="text-3xl font-semibold text-white">{title}</h1>
            <p class="text-sm text-slate-400">{description}</p>
          </div>
          <div class="flex items-center gap-3 text-sm text-slate-300">
            <span class="rounded-full bg-emerald-500/20 px-4 py-2 text-emerald-300">Tailwind v4</span>
            <span class="rounded-full bg-slate-800 px-4 py-2">多框架模式</span>
          </div>
        </header>

        <section class="grid gap-6 md:grid-cols-2">
          <slot />
        </section>
      </main>
    </div>
  </body>
</html>
