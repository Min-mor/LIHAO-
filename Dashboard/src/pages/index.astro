---
import DashboardLayout from "@/layouts/DashboardLayout.astro";
import { Button as ReactButton } from "@react/ui/button";
import {
  Card as ReactCard,
  CardHeader as ReactCardHeader,
  CardTitle as ReactCardTitle,
  CardDescription as ReactCardDescription,
  CardContent as ReactCardContent,
  CardFooter as ReactCardFooter,
} from "@react/ui/card";
import { Button as VueButton } from "@vue/ui/button";
import {
  Card as VueCard,
  CardHeader as VueCardHeader,
  CardTitle as VueCardTitle,
  CardDescription as VueCardDescription,
  CardContent as VueCardContent,
  CardFooter as VueCardFooter,
} from "@vue/ui/card";
---

<DashboardLayout
  title="Aurora Dashboard Seed"
  description="单一 Astro 工程，面向 React 与 Vue 团队的 shadcn 组件实验场"
>
  <section
    class="rounded-2xl border border-white/10 bg-white/[0.02] p-6 shadow-[0_0_30px_rgba(15,23,42,0.35)] backdrop-blur"
  >
    <p class="text-xs uppercase tracking-[0.3em] text-emerald-400/70">
      React Island
    </p>
    <h2 class="mt-2 text-xl font-semibold text-white">
      shadcn/ui React Components
    </h2>
    <p class="mt-1 text-sm text-slate-300">
      CLI：<code
        >npx shadcn@latest add [component] -c components.react.json</code
      >
    </p>

    <div class="mt-6 space-y-6">
      <div class="space-y-2">
        <h3 class="text-sm font-medium text-slate-400">Button</h3>
        <div class="flex flex-wrap gap-3">
          <ReactButton client:load className="min-w-32">React 按钮</ReactButton>
          <ReactButton client:load variant="outline" className="min-w-32"
            >Outline</ReactButton
          >
        </div>
      </div>

      <div class="space-y-2">
        <h3 class="text-sm font-medium text-slate-400">Card</h3>
        <ReactCard className="w-full max-w-sm" client:load>
          <ReactCardHeader>
            <ReactCardTitle>React Project</ReactCardTitle>
            <ReactCardDescription
              >Deploy your new project in one-click.</ReactCardDescription
            >
          </ReactCardHeader>
          <ReactCardContent>
            <p class="text-sm text-slate-400">
              Your new project will be hosted on Vercel.
            </p>
          </ReactCardContent>
          <ReactCardFooter className="flex justify-between">
            <ReactButton variant="outline">Cancel</ReactButton>
            <ReactButton>Deploy</ReactButton>
          </ReactCardFooter>
        </ReactCard>
      </div>
    </div>
  </section>

  <section
    class="rounded-2xl border border-white/10 bg-slate-900/60 p-6 text-left shadow-[0_0_30px_rgba(8,18,28,0.45)] backdrop-blur"
  >
    <p class="text-xs uppercase tracking-[0.3em] text-sky-300/70">Vue Island</p>
    <h2 class="mt-2 text-xl font-semibold text-white">shadcn-vue Components</h2>
    <p class="mt-1 text-sm text-slate-300">
      CLI：<code>npx shadcn-vue@latest add [component] -c components.json</code>
    </p>

    <div class="mt-6 space-y-6">
      <div class="space-y-2">
        <h3 class="text-sm font-medium text-slate-400">Button</h3>
        <div class="flex flex-wrap gap-3">
          <VueButton client:load class="min-w-32">Vue 按钮</VueButton>
          <VueButton client:load variant="outline" class="min-w-32"
            >Outline</VueButton
          >
        </div>
      </div>

      <div class="space-y-2">
        <h3 class="text-sm font-medium text-slate-400">Card</h3>
        <VueCard class="w-full max-w-sm" client:load>
          <VueCardHeader>
            <VueCardTitle>Vue Project</VueCardTitle>
            <VueCardDescription
              >Deploy your new project in one-click.</VueCardDescription
            >
          </VueCardHeader>
          <VueCardContent>
            <p class="text-sm text-slate-400">
              Your new project will be hosted on Vercel.
            </p>
          </VueCardContent>
          <VueCardFooter class="flex justify-between">
            <VueButton variant="outline">Cancel</VueButton>
            <VueButton>Deploy</VueButton>
          </VueCardFooter>
        </VueCard>
      </div>
    </div>
  </section>
</DashboardLayout>
